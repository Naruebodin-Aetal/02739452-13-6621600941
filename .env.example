# Copy to .env and change the passwords: cp .env.example .env
# .env is ignored by Git.

# Data warehouse (tables read by the dashboard)
DATA_DB_NAME=tabletennis
DATA_DB_USER=tabletennis
DATA_DB_PASSWORD=change-me-data
DATA_DB_HOST_PORT=5433

# Airflow metadata database and web UI login
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-admin
AIRFLOW_HOST_PORT=8080

WEB_HOST_PORT=8501

# Sent with every request to the sources (Wikipedia asks for a descriptive agent)
SOURCE_USER_AGENT=TableTennisExamPipeline/1.0 (student project; course 02739452)
